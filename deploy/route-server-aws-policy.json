{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ec2:DescribeRouteTables", "ec2:DescribeNetworkInterfaces"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateRoute", "ec2:ReplaceRoute", "ec2:DeleteRoute"],
      "Resource": [
        "arn:aws:ec2:eu-west-2:123456789012:route-table/rtb-0123456789abcdef0",
        "arn:aws:ec2:eu-west-2:123456789012:route-table/rtb-0fedcba9876543210"
      ],
      "Condition": {"StringEquals": {"ec2:ResourceTag/route-discovery-server": "production"}}
    }
  ]
}
