{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRouteTables",
      "Effect": "Allow",
      "Action": "ec2:DescribeRouteTables",
      "Resource": "*"
    },
    {
      "Sid": "ManageOneOwnedRouteTable",
      "Effect": "Allow",
      "Action": ["ec2:CreateRoute", "ec2:ReplaceRoute", "ec2:DeleteRoute"],
      "Resource": "arn:aws:ec2:eu-west-2:123456789012:route-table/rtb-0123456789abcdef0",
      "Condition": {"StringEquals": {"ec2:ResourceTag/route-discovery": "managed"}}
    }
  ]
}
