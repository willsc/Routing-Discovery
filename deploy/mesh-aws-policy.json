{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMeshRegistry",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REGISTRY_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": "REGISTRY_PREFIX/hosts/*"
        }
      }
    },
    {
      "Sid": "ReadWriteMeshRegistryEntries",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REGISTRY_BUCKET/REGISTRY_PREFIX/hosts/*"
    }
  ]
}
