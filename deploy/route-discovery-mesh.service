[Unit]
Description=Zero-configuration Babel mesh over FRR, with an optional GRE overlay
Wants=network-online.target frr.service
After=network-online.target frr.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=route-discovery
Group=route-discovery
SupplementaryGroups=frrvty
# GRE tunnels, endpoint pins and originated routes for --registry.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
StateDirectory=route-discovery-mesh
StateDirectoryMode=0700
# MESH_ARGS (for example --registry s3://bucket/prefix) and AWS credentials for the registry.
EnvironmentFile=-/etc/default/route-discovery-mesh
ExecStart=/usr/local/bin/route-discovery mesh run --apply $MESH_ARGS
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
